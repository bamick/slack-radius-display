# Slack bot token (xoxb-...)
# Required scopes: channels:read, channels:history
# Optional (for user name display): users:read
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack channel ID for #general (e.g. C0123456789)
# Find it by right-clicking the channel in Slack > View channel details
SLACK_CHANNEL_ID=C0123456789

# A long random string used to protect the display URL
# Generate one with: openssl rand -hex 32
DISPLAY_KEY=your-long-random-display-key-here

# Optional: number of messages to show (default: 15)
# SLACK_MESSAGE_LIMIT=15

# Optional: how often the display refreshes in seconds (default: 30)
# SLACK_REFRESH_SECONDS=30
